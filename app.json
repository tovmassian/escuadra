{
  "expo": {
    "name": "Escuadra",
    "slug": "escuadra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "escuadra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tovmassian.escuadra",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Escuadra adds the picture of your round to Photos only when you choose to save it."
      }
    },
    "locales": {
      "en": "./i18n/ios/en.json",
      "es": "./i18n/ios/es.json",
      "fr": "./i18n/ios/fr.json",
      "it": "./i18n/ios/it.json",
      "de": "./i18n/ios/de.json"
    },
    "android": {
      "package": "com.tovmassian.escuadra",
      "adaptiveIcon": {
        "backgroundColor": "#12141a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f7f7f9",
          "dark": {
            "backgroundColor": "#12141a"
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "es", "fr", "it", "de"],
            "android": ["en", "es", "fr", "it", "de"]
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/withAndroidRelease.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#12141a",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64738e72-9ac7-482a-aa64-f3cdec09bc29"
      },
      "telemetryDeckAppId": "CFD88A5A-F074-4946-AEB6-31DF450DCDFF"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/64738e72-9ac7-482a-aa64-f3cdec09bc29"
    }
  }
}
