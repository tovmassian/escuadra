{
  "name": "escuadra",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "shots": "node scripts/capture-screens.mjs",
    "shots:store": "node scripts/capture-screens.mjs --profile=store",
    "shots:play": "node scripts/capture-screens.mjs --profile=play",
    "gen:play-assets": "node scripts/generate-play-listing-assets.mjs",
    "lint": "expo lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:squads": "node scripts/gen-squads.ts",
    "gen:flags": "node scripts/gen-flags.ts",
    "gen:licences": "node scripts/gen-licences.ts",
    "squadctl": "node tools/squadctl/bin/dev.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run squadctl -- registry check && npm run gen:squads && npm run gen:flags && npm run gen:licences && git diff --exit-code -- lib/squads.generated.ts data/index.json assets/flags/generated.ts lib/licences.generated.ts",
    "prepare": "husky",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@telemetrydeck/sdk": "^2.0.4",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@oclif/core": "^5.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "private": true,
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents": true
  }
}
